import requests
import sys
if len(sys.argv) != 2:
    sys.exit("Missing command-line argument")

try:
    bitcoins = float(sys.argv[1])
except ValueError:
    sys.exit("Command-line argument is not a number")

try:
    response = requests.get("https://rest.coincap.io/v3/assets/bitcoin?apiKey=b59d78fbd0057bc9345389c4f84bcf3e5595f454ac7747eb073f631a787ac6a0")
    data= response.json()
    price = float(data["data"]["priceUsd"])
except requests.RequestException:
    sys.exit("API request failed")

total = bitcoins * price
print(f"${total:,.4f}")
